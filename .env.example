# Dùng `demo` cho tài khoản mẫu; đổi thành `live` để gọi NRApp Gateway.
NEXT_PUBLIC_APP_MODE=demo

# Cấu hình Gateway chỉ dành cho máy chủ, không chuyển sang NEXT_PUBLIC_*.
NRAPP_API_URL=http://127.0.0.1:3000/api
NRAPP_API_TIMEOUT_MS=10000

# Mặc định true ở production và false ở development. Chỉ tắt khi chạy
# `next start` cục bộ qua HTTP thuần.
# NRAPP_COOKIE_SECURE=false

# Socket.IO công khai cho phần chat sẽ được tích hợp sau.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
