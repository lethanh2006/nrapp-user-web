# `demo` keeps the sample account available; use `live` to call NRApp Gateway.
NEXT_PUBLIC_APP_MODE=demo

# Server-only Gateway settings. Do not expose this URL through NEXT_PUBLIC_*.
NRAPP_API_URL=http://127.0.0.1:3000/api
NRAPP_API_TIMEOUT_MS=10000

# Optional browser-facing Socket.IO endpoint for the chat integration.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
