# Cấu hình Gateway chỉ dành cho máy chủ, không chuyển sang NEXT_PUBLIC_*.
NRAPP_API_URL=https://api-vps.thanhlelmtp2006.id.vn/api
NRAPP_API_TIMEOUT_MS=10000

# Client ID công khai dùng chung với GOOGLE_WEB_CLIENT_ID của Auth service.
# Thêm origin của web (ví dụ http://localhost:3002) vào Authorized JavaScript origins
# trong Google Cloud Console trước khi dùng đăng nhập Google.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=779200897119-2m0amhfd2prcpuuec18502f14vlfbh3f.apps.googleusercontent.com

# Mặc định true ở production và false ở development. Chỉ tắt khi chạy
# `next start` cục bộ qua HTTP thuần.
# NRAPP_COOKIE_SECURE=false

# Socket.IO công khai cho phần chat sẽ được tích hợp sau.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
